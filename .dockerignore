# =============================================================================
# FlowyML Docker Ignore
# =============================================================================
# Exclude files and directories that should not be copied to Docker build context
# This significantly reduces build time and image size
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-*

# Testing
.coverage
.pytest_cache/
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Documentation
docs/_build/
site/

# Local development
.flowyml/
*.db
*.sqlite
*.sqlite3
artifacts/
metadata/

# Secrets and configs (never include in images)
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# Node.js (for frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts (will be created in container)
flowyml/ui/frontend/dist/
flowyml/ui/frontend/node_modules/

# Misc
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db

# Docker
Dockerfile*
docker-compose*.yml
.docker/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Inspiration / examples (not needed in production)
inspiration-only/
examples/
.system_generated/
docs/
