# FlowyML Local Development Environment Variables
# ================================================
# Copy this file to .env and modify as needed
#
# WARNING: Never commit .env to version control!
# ================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=flowyml
POSTGRES_PASSWORD=flowyml_secure_password
POSTGRES_DB=flowyml
FLOWYML_DATABASE_URL=postgresql://flowyml:flowyml_secure_password@postgres:5432/flowyml

# -----------------------------------------------------------------------------
# FlowyML Backend Configuration
# -----------------------------------------------------------------------------
FLOWYML_ENV=development
FLOWYML_PORT=8080
FLOWYML_REMOTE_SERVER_URL=http://localhost:8080
FLOWYML_REMOTE_UI_URL=http://localhost:80

# Authentication
#
# FLOWYML_ENV=production makes the server fail closed: it refuses to start
# unless FLOWYML_API_TOKEN and FLOWYML_ADMIN_PASSWORD are both set to real
# values. That is deliberate - POST /api/execution/execute imports and runs
# arbitrary Python modules, so an unauthenticated instance is remote code
# execution, and an empty FLOWYML_API_TOKEN used to disable authentication
# silently.
#
# Generate a token with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FLOWYML_AUTH_SECRET=change-this-secret-in-production
FLOWYML_API_TOKEN=
FLOWYML_ADMIN_USER=admin
FLOWYML_ADMIN_PASSWORD=

# Set to 1 only when authentication is enforced by a proxy in front of FlowyML.
# This disables the built-in checks; do not set it otherwise.
FLOWYML_ALLOW_INSECURE=

# Comma-separated browser origins allowed to call the API. Defaults to the
# usual localhost dev ports in development. A wildcard is never used: combined
# with credentials it would let any website read this API.
FLOWYML_CORS_ORIGINS=

# Logging
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# FlowyML Frontend Configuration
# -----------------------------------------------------------------------------
FLOWYML_UI_PORT=80
VITE_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Observability Stack
# -----------------------------------------------------------------------------
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
